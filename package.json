{
  "name": "narrationlayer",
  "version": "1.0.0",
  "private": false,
  "description": "Neutral narrated-asset service for script-to-voice rendering.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "narration",
    "tts",
    "mcp",
    "teleprompter"
  ],
  "bin": {
    "narrationlayer": "./src/cli.ts",
    "narrationlayer-mcp": "./src/mcp-server.ts",
    "narrationlayer-local-tts": "./bin/local-tts-runner.ts"
  },
  "exports": {
    ".": "./src/api/index.ts",
    "./package.json": "./package.json",
    "./bin/local-tts-runner.ts": "./bin/local-tts-runner.ts",
    "./bin/narration-gate.ts": "./bin/narration-gate.ts",
    "./src/audio.ts": "./src/audio.ts",
    "./src/bakeoff.ts": "./src/bakeoff.ts",
    "./src/cli.ts": "./src/cli.ts",
    "./src/contract.ts": "./src/contract.ts",
    "./src/dashboard.ts": "./src/dashboard.ts",
    "./src/job-store.ts": "./src/job-store.ts",
    "./src/mcp-server.ts": "./src/mcp-server.ts",
    "./src/narration-plan.ts": "./src/narration-plan.ts",
    "./src/path-safety.ts": "./src/path-safety.ts",
    "./src/profile-renderer-types.ts": "./src/profile-renderer-types.ts",
    "./src/profiles.ts": "./src/profiles.ts",
    "./src/qwen3-lora.ts": "./src/qwen3-lora.ts",
    "./src/renderers/external-command.ts": "./src/renderers/external-command.ts",
    "./src/renderers/fake.ts": "./src/renderers/fake.ts",
    "./src/renderers/types.ts": "./src/renderers/types.ts",
    "./src/renderers/voicelayer-qwen3.ts": "./src/renderers/voicelayer-qwen3.ts",
    "./src/schema.ts": "./src/schema.ts",
    "./src/service.ts": "./src/service.ts",
    "./src/teleprompter.ts": "./src/teleprompter.ts",
    "./src/text-normalize.ts": "./src/text-normalize.ts",
    "./src/word-timing-repair.ts": "./src/word-timing-repair.ts",
    "./src/word-timings.ts": "./src/word-timings.ts"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "narrationlayer": "bun run ./src/cli.ts",
    "mcp-server": "bun run ./src/mcp-server.ts",
    "doctor": "bun run ./src/cli.ts doctor",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "answers": "node ./packages/dashboard-publish/answers-export.mjs",
    "conformance": "bun run ./src/engine/conformance/entry.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "happy-dom": "^20.10.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "dependencies": {
    "lakebed": "0.0.41"
  }
}
