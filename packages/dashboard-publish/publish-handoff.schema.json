{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "audio-dashboard.publish-handoff.v2"
    },
    "dashboardId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "decision-flow",
        "cinema",
        "visual"
      ]
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "builtHtmlSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "answerRuntimeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceHtmlSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "buildReceiptsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "answerPersistence": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "answerKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "text",
              "radio",
              "checkbox",
              "select"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "key",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "design": {
      "type": "object",
      "properties": {
        "admission": {
          "enum": [
            "COMPARED",
            "REDESIGN_APPROVED",
            "FIRST_IN_LINEAGE"
          ]
        },
        "lineage": {
          "type": "string",
          "minLength": 1
        },
        "predecessorSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "redesign": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "not": {
                "pattern": "[\\r\\n\\v\\f\\x1c-\\x1e\\x85\\u2028\\u2029]"
              }
            },
            "approvedBy": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "not": {
                "pattern": "[\\r\\n\\v\\f\\x1c-\\x1e\\x85\\u2028\\u2029]"
              },
              "allOf": [
                {
                  "not": {
                    "pattern": "^\\s*[uU][nN][rR][eE][cC][oO][rR][dD][eE][dD]\\s*$"
                  }
                }
              ]
            },
            "from": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "reason",
            "approvedBy",
            "from"
          ],
          "additionalProperties": false
        },
        "firstInLineage": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "not": {
                "pattern": "[\\r\\n\\v\\f\\x1c-\\x1e\\x85\\u2028\\u2029]"
              }
            },
            "approvedBy": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "not": {
                "pattern": "[\\r\\n\\v\\f\\x1c-\\x1e\\x85\\u2028\\u2029]"
              },
              "allOf": [
                {
                  "not": {
                    "pattern": "^\\s*[uU][nN][rR][eE][cC][oO][rR][dD][eE][dD]\\s*$"
                  }
                }
              ]
            }
          },
          "required": [
            "reason",
            "approvedBy"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "admission",
        "lineage",
        "predecessorSha256"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "admission": {
                "const": "FIRST_IN_LINEAGE"
              }
            }
          },
          "then": {
            "properties": {
              "predecessorSha256": {
                "type": "null"
              },
              "firstInLineage": {
                "properties": {
                  "approvedBy": {
                    "pattern": "\\S",
                    "not": {
                      "pattern": "^\\s*[uU][nN][rR][eE][cC][oO][rR][dD][eE][dD]\\s*$"
                    }
                  }
                }
              }
            },
            "required": [
              "firstInLineage"
            ]
          },
          "else": {
            "properties": {
              "predecessorSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admission": {
                "const": "REDESIGN_APPROVED"
              }
            }
          },
          "then": {
            "required": [
              "redesign"
            ]
          }
        }
      ]
    },
    "mediaManifest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "mp3",
              "webp",
              "png",
              "jpeg",
              "svg"
            ]
          }
        },
        "required": [
          "file",
          "size",
          "sha256"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "not": {
                "required": [
                  "kind"
                ]
              }
            },
            "then": {
              "properties": {
                "file": {
                  "pattern": "^assets/[A-Za-z0-9_-]+\\.(mp3)$"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "mp3"
                }
              }
            },
            "then": {
              "properties": {
                "file": {
                  "pattern": "^assets/[A-Za-z0-9_-]+\\.(mp3)$"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "webp"
                }
              }
            },
            "then": {
              "properties": {
                "file": {
                  "pattern": "^assets/[A-Za-z0-9_-]+\\.(webp)$"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "png"
                }
              }
            },
            "then": {
              "properties": {
                "file": {
                  "pattern": "^assets/[A-Za-z0-9_-]+\\.(png)$"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "jpeg"
                }
              }
            },
            "then": {
              "properties": {
                "file": {
                  "pattern": "^assets/[A-Za-z0-9_-]+\\.(jpg|jpeg)$"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "svg"
                }
              }
            },
            "then": {
              "properties": {
                "file": {
                  "pattern": "^assets/[A-Za-z0-9_-]+\\.(svg)$"
                }
              }
            }
          }
        ]
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema",
    "dashboardId",
    "type",
    "sourcePath",
    "builtHtmlSha256",
    "sourceHtmlSha256",
    "buildReceiptsSha256",
    "answerKeys",
    "design",
    "mediaManifest",
    "createdAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "visual"
          }
        }
      },
      "then": {
        "properties": {
          "answerKeys": {
            "maxItems": 0
          },
          "mediaManifest": {
            "items": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "not": {
                    "const": "mp3"
                  }
                }
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "answerRuntimeSha256"
              ]
            },
            {
              "required": [
                "answerPersistence"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "answerRuntimeSha256",
          "answerPersistence"
        ]
      }
    }
  ]
}
