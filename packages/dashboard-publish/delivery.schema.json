{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "audio-dashboard.delivery.v2"
        },
        "host": {
          "const": "lakebed"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "dashboardId": {
          "type": "string",
          "minLength": 1
        },
        "sourceHtmlSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "servedShellSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "staging": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "unlisted-candidate",
                "in-place-maintenance"
              ]
            },
            "servedShellSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "previousServedShellSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "mode",
            "servedShellSha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "in-place-maintenance"
                  }
                }
              },
              "then": {
                "required": [
                  "previousServedShellSha256"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "previousServedShellSha256"
                  ]
                }
              }
            }
          ]
        },
        "accountProof": {
          "type": "object",
          "properties": {
            "signedIn": {
              "const": true
            },
            "markerSaved": {
              "const": true
            },
            "restoredAfterLocalKeysCleared": {
              "const": true
            },
            "cleanedUp": {
              "const": true,
              "description": "Restored to the pre-probe value; the row may remain because the API has no row delete."
            },
            "disposableRecord": {
              "const": true,
              "description": "The probed value contained no user data before the probe."
            },
            "independentClient": {
              "const": true
            },
            "serverAck": {
              "const": true
            },
            "method": {
              "const": "note-roundtrip"
            },
            "probe": {
              "enum": [
                "existing-empty-field",
                "dedicated-key"
              ]
            },
            "mutationDelta": {
              "type": "integer",
              "minimum": 0
            },
            "existingRowsPreserved": {
              "type": "integer",
              "minimum": 0
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "signedIn",
            "markerSaved",
            "restoredAfterLocalKeysCleared",
            "cleanedUp",
            "disposableRecord",
            "independentClient",
            "serverAck",
            "method",
            "probe",
            "mutationDelta",
            "existingRowsPreserved",
            "at"
          ],
          "additionalProperties": false
        },
        "admission": {
          "type": "object",
          "properties": {
            "design": {
              "enum": [
                "COMPARED",
                "REDESIGN_APPROVED",
                "FIRST_IN_LINEAGE"
              ]
            },
            "answerIdentity": {
              "const": "PASS"
            },
            "providerReady": {
              "const": true
            },
            "answerRuntime": {
              "enum": [
                "current",
                "deprecated"
              ]
            },
            "gateVersion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "design",
            "answerIdentity",
            "providerReady",
            "answerRuntime",
            "gateVersion"
          ],
          "additionalProperties": false
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema",
        "host",
        "url",
        "dashboardId",
        "sourceHtmlSha256",
        "servedShellSha256",
        "artifactSha256",
        "staging",
        "accountProof",
        "admission",
        "publishedAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "staging": {
                "properties": {
                  "mode": {
                    "const": "in-place-maintenance"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "admission": {
                "properties": {
                  "design": {
                    "enum": [
                      "COMPARED",
                      "REDESIGN_APPROVED"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "audio-dashboard.delivery.v2"
        },
        "host": {
          "const": "lakebed"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "dashboardId": {
          "type": "string",
          "minLength": 1
        },
        "sourceHtmlSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "servedShellSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "staging": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none-backfill"
              ]
            },
            "servedShellSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "mode",
            "servedShellSha256"
          ],
          "additionalProperties": false
        },
        "accountProof": {
          "type": "object",
          "properties": {
            "signedIn": {
              "const": true
            },
            "markerSaved": {
              "const": true
            },
            "restoredAfterLocalKeysCleared": {
              "const": true
            },
            "cleanedUp": {
              "const": true,
              "description": "Restored to the pre-probe value; the row may remain because the API has no row delete."
            },
            "disposableRecord": {
              "const": true,
              "description": "The probed value contained no user data before the probe."
            },
            "independentClient": {
              "const": true
            },
            "serverAck": {
              "const": true
            },
            "method": {
              "const": "note-roundtrip"
            },
            "probe": {
              "enum": [
                "existing-empty-field",
                "dedicated-key"
              ]
            },
            "mutationDelta": {
              "type": "integer",
              "minimum": 0
            },
            "existingRowsPreserved": {
              "type": "integer",
              "minimum": 0
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "signedIn",
            "markerSaved",
            "restoredAfterLocalKeysCleared",
            "cleanedUp",
            "disposableRecord",
            "independentClient",
            "serverAck",
            "method",
            "probe",
            "mutationDelta",
            "existingRowsPreserved",
            "at"
          ],
          "additionalProperties": false
        },
        "admission": {
          "type": "object",
          "properties": {
            "design": {
              "const": "UNKNOWN_BACKFILL"
            },
            "answerIdentity": {
              "const": "PASS"
            },
            "providerReady": {
              "const": true
            },
            "answerRuntime": {
              "enum": [
                "current",
                "deprecated"
              ]
            },
            "gateVersion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "design",
            "answerIdentity",
            "providerReady",
            "answerRuntime",
            "gateVersion"
          ],
          "additionalProperties": false
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "backfilled": {
          "const": true
        }
      },
      "required": [
        "schema",
        "host",
        "url",
        "dashboardId",
        "sourceHtmlSha256",
        "servedShellSha256",
        "artifactSha256",
        "staging",
        "accountProof",
        "admission",
        "publishedAt",
        "backfilled"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/oneOf/0/properties/schema"
        },
        "host": {
          "$ref": "#/oneOf/0/properties/host"
        },
        "url": {
          "$ref": "#/oneOf/0/properties/url"
        },
        "dashboardId": {
          "$ref": "#/oneOf/0/properties/dashboardId"
        },
        "sourceHtmlSha256": {
          "$ref": "#/oneOf/0/properties/sourceHtmlSha256"
        },
        "servedShellSha256": {
          "$ref": "#/oneOf/0/properties/servedShellSha256"
        },
        "artifactSha256": {
          "$ref": "#/oneOf/0/properties/artifactSha256"
        },
        "staging": {
          "$ref": "#/oneOf/0/properties/staging"
        },
        "publishedAt": {
          "$ref": "#/oneOf/0/properties/publishedAt"
        },
        "accountProof": {
          "type": "object",
          "description": "A visual page has no answer to round-trip: a signed-in render of the served shell at both widths, every image fetched with its own bytes and type, no answer row, and a signed-out refusal.",
          "properties": {
            "method": {
              "const": "visual-render"
            },
            "signedIn": {
              "const": true
            },
            "renders": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "width": {
                    "enum": [
                      390,
                      1280
                    ]
                  },
                  "signedIn": {
                    "const": true
                  },
                  "dashboardId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "shellSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "imagesLoaded": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^assets/[A-Za-z0-9_-]+\\.(webp|png|jpg|jpeg|svg)$"
                    },
                    "uniqueItems": true
                  },
                  "noOverflow": {
                    "const": true
                  }
                },
                "required": [
                  "width",
                  "signedIn",
                  "dashboardId",
                  "shellSha256",
                  "imagesLoaded",
                  "noOverflow"
                ],
                "additionalProperties": false
              },
              "minItems": 2,
              "maxItems": 2
            },
            "media": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "pattern": "^assets/[A-Za-z0-9_-]+\\.(webp|png|jpg|jpeg|svg)$"
                  },
                  "status": {
                    "type": "integer"
                  },
                  "contentType": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "loadedFrom": {
                    "type": "string"
                  }
                },
                "required": [
                  "file",
                  "status",
                  "contentType",
                  "sha256",
                  "bytes",
                  "loadedFrom"
                ],
                "additionalProperties": false
              }
            },
            "answerRowsAfter": {
              "type": "integer",
              "minimum": 0
            },
            "signedOut": {
              "type": "object",
              "properties": {
                "request": {
                  "enum": [
                    "media",
                    "page"
                  ]
                },
                "status": {
                  "type": "integer"
                }
              },
              "required": [
                "request",
                "status"
              ],
              "additionalProperties": false
            },
            "existingRowsPreserved": {
              "type": "integer",
              "minimum": 0
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "method",
            "signedIn",
            "renders",
            "media",
            "answerRowsAfter",
            "signedOut",
            "existingRowsPreserved",
            "at"
          ],
          "additionalProperties": false
        },
        "admission": {
          "type": "object",
          "properties": {
            "pageType": {
              "const": "visual"
            },
            "design": {
              "$ref": "#/oneOf/0/properties/admission/properties/design"
            },
            "answerRuntime": {
              "const": "none"
            },
            "gateVersion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "pageType",
            "design",
            "answerRuntime",
            "gateVersion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "host",
        "url",
        "dashboardId",
        "sourceHtmlSha256",
        "servedShellSha256",
        "artifactSha256",
        "staging",
        "accountProof",
        "admission",
        "publishedAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/oneOf/0/allOf/0"
        }
      ]
    }
  ]
}
